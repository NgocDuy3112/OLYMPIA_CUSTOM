# ── Discord bot ──
API_BASE_URL=http://app:8000/api
EXECUTOR_PORT=8200
# Staff account cho bot (operator + controller) — session thay token riêng.
BOT_STAFF_USERNAME=change-me
BOT_STAFF_PASSWORD=change-me

# MCP discord (:8301) — chung format MCP: name:token:role:scopes (";")
# role ⊂ admin,operator,agent. Discord chưa chia scope (full 4 tools).
# Legacy token trần vẫn chạy (role agent). Rỗng = dev mở.
MCP_HTTP_TOKENS=change-me
