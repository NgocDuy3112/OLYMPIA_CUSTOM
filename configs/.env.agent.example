# ── AI Agent (OCee) ──
OPENROUTER_API_KEY=your-openrouter-key
LLM_MODEL=your-model-name
LLM_TIMEOUT=30
MCP_BASE_URL=http://oc-app:8300
MCP_TOKEN=change-me
MCP_DISCORD_URL=http://oc-discord-bot:8301
MCP_DISCORD_TOKEN=change-me

# Postgres checkpointer — DB + user riêng agent (không chung backend).
# Tạo 1 lần: CREATE USER agent_user WITH PASSWORD '...';
#            CREATE DATABASE agent OWNER agent_user;
# Trống = MemorySaver RAM.
POSTGRES_URL=postgresql://agent_user:change-me@postgresql:5432/agent
