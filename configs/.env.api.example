# ── API (app) ──
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:4173
CORS_ORIGINS=*

# Auth (Google OAuth + staff)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Service tokens (shared secrets)
AGENT_SERVICE_TOKEN=change-me
BOT_SERVICE_TOKEN=change-me
BOT_EXECUTOR_URL=http://oc-discord-bot:8200

# Media (S3)
S3_ENDPOINT_URL=https://s3.vn-hcm-1.vietnix.cloud
S3_REGION=vn-hcm-1
S3_PRESIGNED_URL_EXPIRY=3600
S3_MAX_UPLOAD_SIZE_MB=50
S3_BUCKET_NAME=your-bucket-name
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key

# Backup
BACKUP_S3_BUCKET=your-backup-bucket-name
BACKUP_S3_ACCESS_KEY_ID=xxx
BACKUP_S3_SECRET_ACCESS_KEY=xxx

# Deploy (domain + TLS)
DOMAIN=olympia.yourdomain.com
CERTBOT_EMAIL=admin@yourdomain.com
