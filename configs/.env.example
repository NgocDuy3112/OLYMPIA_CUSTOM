# ── Application ─────────────────────────────────────────────
APP_HOST=127.0.0.1
APP_PORT=8000
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=180

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_DB_USER=olympia
POSTGRES_DB_PASSWORD=change-me
POSTGRES_DB_HOST=postgresql
POSTGRES_DB_PORT=5432
POSTGRES_DB_NAME=olympia_custom

# ── Valkey ──────────────────────────────────────────────────
VALKEY_USER=default
VALKEY_PASSWORD=change-me
VALKEY_HOST=valkey
VALKEY_PORT=6379

# ── Google Drive ────────────────────────────────────────────
GOOGLE_DRIVE_SCOPE=https://www.googleapis.com/auth/drive
DRIVE_CREDENTIALS_FILE=./configs/credentials.json

# ── Email (password reset) ─────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM_NAME=Olympia Custom

# ── Deployment (used by docker-compose.prod.yaml) ───────────
# Domain name for HTTPS (Let's Encrypt)
DOMAIN=olympia.yourdomain.com
# Email for Let's Encrypt certificate notifications
CERTBOT_EMAIL=admin@yourdomain.com

# ── ngrok (used by docker-compose.ngrok.yaml) ───────────────
# Get token from: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=your-ngrok-authtoken
# Static domain from: https://dashboard.ngrok.com/domains
NGROK_DOMAIN=your-static-domain.ngrok-free.app

# ── Discord Bots ────────────────────────────────────────────
# BGM bot token (previously MUSIC_BOT_TOKEN)
BGM_BOT_TOKEN=your-bgm-bot-token-here
SFX_BOT_TOKEN=your-sfx-bot-token-here
CHATBOT_BOT_TOKEN=your-chatbot-token-here
VOICE_CHANNEL_ID=

# ── AI / RAG (OpenRouter — primary) ─────────────────────────
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── AI / RAG (Ollama — fallback) ────────────────────────────
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434/v1

# ── Embedding ────────────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
RAG_TOP_K=5
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
