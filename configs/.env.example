# ── Application ─────────────────────────────────────────────
APP_HOST=127.0.0.1
APP_PORT=8000
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Season ────────────────────────────────────────────────
# Olympia season (version) used to build the match-code prefix everywhere
# (e.g. SEASON=3 → "OC3_M", SEASON=4 → "OC4_M"). Bump this to retarget the
# whole app + bots to a new season. Defaults to 3 if unset.
SEASON=3

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_DB_USER=olympia
POSTGRES_DB_PASSWORD=change-me
POSTGRES_DB_HOST=postgresql
POSTGRES_DB_PORT=5432
POSTGRES_DB_NAME=olympia_custom

# ── Valkey ──────────────────────────────────────────────────
VALKEY_USER=default
VALKEY_PASSWORD=change-me
VALKEY_HOST=valkey
VALKEY_PORT=6379

# ── S3 Media Storage ────────────────────────────────────────
# Để trống S3_ENDPOINT_URL nếu dùng AWS S3 chuẩn.
# Điền URL endpoint nếu dùng provider khác (Vietnix, MinIO, Tigris…).
S3_ENDPOINT_URL=https://s3.your-provider.com
S3_REGION=us-east-1
S3_BUCKET_NAME=your-bucket-name
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
S3_PRESIGNED_URL_EXPIRY=3600
S3_MAX_UPLOAD_SIZE_MB=50

# ── Email (password reset) ─────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM_NAME=Olympia Custom

# ── Discord Bots ────────────────────────────────────────────
BGM_BOT_TOKEN=your-bgm-bot-token
SFX_BOT_TOKEN=your-sfx-bot-token
VOICE_CHANNEL_ID=your-voice-channel-id

# ── Deployment (production only) ────────────────────────────
# Chỉ cần khi dùng docker-compose.prod.yaml với Let's Encrypt.
DOMAIN=olympia.yourdomain.com
CERTBOT_EMAIL=admin@yourdomain.com
