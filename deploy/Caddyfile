# olympia-custom — deployment shape
#
# THREE hosts, ONE backend. Each host serves its own bundle and PATH-PROXIES the
# API prefixes it needs, so every browser request is same-origin:
#
#   portal.aoc.olympia-custom.io.vn     the console/admin bundle   → /portal/*   (+ /spectate/* while the operator opens the audience view)
#   gameplay.aoc.olympia-custom.io.vn   the player bundle          → /gameplay/*
#   aoc.olympia-custom.io.vn            the audience bundle        → /spectate/* + /public/*
#
# Why path-proxied and not an api.* host: cookies stay HOST-ONLY (`portal_session`
# on portal.*, `gameplay_session` on gameplay.*, none on the audience host), CORS
# never runs, the live socket upgrades are same-origin, and the OAuth callback
# lands on the host whose cookie it sets. See backend/src/app.ts for the dev-only
# CORS list.
#
# TLS: one certificate per host via the HTTP challenge — no DNS plugin needed.
# A wildcard (*.aoc.olympia-custom.io.vn) would need a DNS challenge AND still not
# cover the apex `aoc.olympia-custom.io.vn`; three explicit names is the simpler
# truth. Swap in a DNS provider block here if you prefer one cert.

{
	email {$ACME_EMAIL:ops@olympia-custom.io.vn}
}

(security_headers) {
	header {
		# The app is HTTPS-only; remember it.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		# No SPA caching surprises: the hashed assets carry their own cache headers.
		-Server
	}
}

# ── the API hops, shared by the three hosts ──────────────────────────────────
(api) {
	# The round's live stream is a WebSocket — Caddy forwards the upgrade by
	# default for reverse_proxy, no extra config.
	reverse_proxy {$BACKEND_UPSTREAM:backend:3000} {
		# API answers are never cached, never compressed twice.
		header_up X-Forwarded-Proto {scheme}
	}
}

# ── 1. the console / admin ───────────────────────────────────────────────────
# The admin host talks to /portal/* ONLY. The audience deck used to live here
# (/tournaments/:t/matches/:m/spectate); it now belongs to the audience host, and
# the old links redirect there so an operator's bookmark keeps working.
portal.aoc.olympia-custom.io.vn {
	import security_headers
	encode zstd gzip

	# The old spectator deep link → the audience host's live deck.
	@oldSpectate path_regexp /tournaments/([^/]+)/matches/([^/]+)/spectate
	redir @oldSpectate https://aoc.olympia-custom.io.vn/live/{re.oldSpectate.1}/{re.oldSpectate.2}

	@api path /portal/*
	handle @api {
		import api
	}
	handle {
		reverse_proxy {$PORTAL_APP:portal:80}
	}
}

# ── 2. the player deck ──────────────────────────────────────────────────────
gameplay.aoc.olympia-custom.io.vn {
	import security_headers
	encode zstd gzip

	@api path /gameplay/*
	handle @api {
		import api
	}
	handle {
		reverse_proxy {$GAMEPLAY_APP:gameplay:80}
	}
}

# ── 3. the audience — "Khán giả cùng leo núi" ───────────────────────────────
# Public, link-only, no session of any kind. It may read the live projection
# (/spectate/* — answers stripped, no ledger) and, once it exists, the public
# tournament pages (/public/*). It gets NEITHER /portal/* NOR /gameplay/*, so the
# admin and player APIs are not even reachable from this host.
aoc.olympia-custom.io.vn {
	import security_headers
	encode zstd gzip

	@api path /spectate/* /public/*
	handle @api {
		import api
	}

	# The record page (the egress composite) mints its spectator token through
	# the gameplay door — ONE narrow path, never the whole /gameplay surface,
	# so this host keeps its "player APIs unreachable" property.
	@viewerToken path_regexp ^/gameplay/matches/[^/]+/rtc/viewer-token$
	handle @viewerToken {
		import api
	}
	handle {
		reverse_proxy {$AUDIENCE_APP:audience:80}
	}
}
