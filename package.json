{
  "name": "olympia-v4",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "db:generate": "pnpm --filter @olympia/db generate",
    "db:migrate": "pnpm --filter @olympia/db migrate",
