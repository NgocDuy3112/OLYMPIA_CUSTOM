# --- Server ---
NODE_ENV=development
PORT=3000

# --- Database (Drizzle + pg) ---
DATABASE_URL=postgres://user:password@localhost:5432/olympia

# --- JWT secrets ---
# Separate secrets per surface: a leak on one must not allow forging the other.
PLAYER_JWT_SECRET=change-me-32-chars-minimum-player
ADMIN_JWT_SECRET=change-me-32-chars-minimum-admin

# --- Cookie domains (host-only cookies; leave unset for host-only) ---
# PLAYER_COOKIE_DOMAIN=
# ADMIN_COOKIE_DOMAIN=

# --- Google OIDC (player login on gameplay.*) ---
GOOGLE_OIDC_ISSUER=https://accounts.google.com
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
GOOGLE_OIDC_REDIRECT_URI=https://gameplay.olympia-custom.io.vn/auth/google/callback

# --- S3 (media uploads) ---
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
