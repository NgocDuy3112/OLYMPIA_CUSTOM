POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_CONTAINER=oc-postgresql-18

GAMEPLAY_JWT_SECRET=<openssl rand -hex 32>
PORTAL_JWT_SECRET=<openssl rand -hex 32>

SEED_ADMIN_PASSWORD=

# ── WebRTC player webcams (LiveKit SFU) ─────────────────────────────────────
# Both the livekit container (validates join tokens) and the backend (mints
# them) read these — one source of truth, no duplication. API key must be
# alphanumeric; secret: openssl rand -hex 32 (>= 32 chars, else the server
# logs a security warning).
LIVEKIT_URL=http://localhost:7880
LIVEKIT_API_KEY=oc_dev_key
LIVEKIT_API_SECRET=<openssl rand -hex 32>
