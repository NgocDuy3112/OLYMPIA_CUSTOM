POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_CONTAINER=oc-postgresql-18

GAMEPLAY_JWT_SECRET=<openssl rand -hex 32>
PORTAL_JWT_SECRET=<openssl rand -hex 32>

SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=

LIVEKIT_URL=http://localhost:7880
LIVEKIT_API_KEY=oc_dev_key
LIVEKIT_API_SECRET=<openssl rand -hex 32>

RECORD_PAGE_BASE_URL=

S3_ENDPOINT=https://s3.vn-hcm-1.vietnix.cloud
S3_REGION=vn-hcm-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

GOOGLE_OIDC_ISSUER=https://accounts.google.com
GOOGLE_OIDC_CLIENT_ID=<…>.apps.googleusercontent.com
GOOGLE_OIDC_CLIENT_SECRET=<…>
GOOGLE_OIDC_REDIRECT_URI=http://localhost:5175/gameplay/auth/google/callback
# Optional: mirror WARNING+ backend log lines into a Discord channel.
# Discord → Channel settings → Integrations → Webhooks → New Webhook → copy URL.
# Empty = off; the console (podman logs aoc-backend) stays the record either way.
DISCORD_WEBHOOK_URL=
# Trace|Debug|Information|Warning|Error|Critical — what reaches the webhook
DISCORD_LOG_LEVEL=Warning
