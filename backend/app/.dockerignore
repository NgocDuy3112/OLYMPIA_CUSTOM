# .dockerignore for backend/app
# Exclude virtualenvs, caches, logs, tests and local secrets from the Docker build context

# Python environments and caches
.venv
venv
env
__pycache__/
*.py[cod]
pip-wheel-metadata/
pip-selfcheck.json

# Tests and coverage
tests/
.pytest_cache/
htmlcov/
coverage/

# Logs and runtime files
logs/
*.log
*.sqlite3

# Local configuration / secrets
.env
*.env
credentials.json
configs/.env

# Build / packaging
build/
dist/
*.egg-info/
.eggs/

# Editor / OS files
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# Frontend / node artifacts (in case frontend is copied into backend context)
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/

# Git and docker metadata
.git/
.gitignore
Dockerfile*
.dockerignore
