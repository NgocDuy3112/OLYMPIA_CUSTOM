{
    "name": "olympia-custom-backend",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "tsx watch --env-file=configs/.env src/server.ts",
        "start": "tsx --env-file=configs/.env src/server.ts",
        "typecheck": "tsc --noEmit",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:studio": "drizzle-kit studio",
        "seed:admin": "tsx --env-file=configs/.env src/db/seed.ts"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1146.0",
        "@aws-sdk/s3-request-presigner": "^3.1146.0",
        "@fastify/cookie": "^11.0.2",
        "@fastify/cors": "^11.3.0",
        "@fastify/jwt": "^10.2.4",
        "@fastify/websocket": "^11.3.3",
        "argon2": "^0.45.1",
        "drizzle-orm": "^0.45.2",
        "fastify": "^5.12.5",
        "openid-client": "^6.7.1",
        "otplib": "^13.5.0",
        "pg": "^8.23.1"
    },
    "devDependencies": {
        "@types/node": "^26.6.4",
        "@types/pg": "^8.23.1",
        "@types/ws": "^8.18.2",
        "drizzle-kit": "^0.31.11",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    }
}
