{
    "compilerOptions": {
        "target": "es2023",
        "lib": [
            "ES2023",
            "DOM",
            "DOM.Iterable"
        ],
        "module": "esnext",
        "moduleResolution": "bundler",
        "types": [
            "vite/client",
            "node"
        ],
        "jsx": "react-jsx",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "verbatimModuleSyntax": true,
        "moduleDetection": "force",
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "paths": {
            "@/*": [
                "./src/*"
            ],
            "@shared/*": [
                "../../shared/*"
            ]
        }
    },
    "include": [
        "src",
        "tests",
        "vite.config.ts",
        "vitest.config.ts"
, "tests"    ]
}