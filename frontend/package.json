{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:portal",
    "dev:portal": "vite --config apps/portal/vite.config.ts",
    "dev:gameplay": "vite --config apps/gameplay/vite.config.ts",
    "build": "npm run build:portal && npm run build:gameplay",
    "build:portal": "tsc -p apps/portal --noEmit && vite build --config apps/portal/vite.config.ts",
    "build:gameplay": "tsc -p apps/gameplay --noEmit && vite build --config apps/gameplay/vite.config.ts",
    "preview:portal": "vite preview --config apps/portal/vite.config.ts",
    "preview:gameplay": "vite preview --config apps/gameplay/vite.config.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.52.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.8.0",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  }
}
